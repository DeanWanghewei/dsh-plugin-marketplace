  "type": "module",
  "description": "dshm — plugin marketplace for deepseek-harness: search, install, uninstall, and categorize plugins",
  "bin": {
    "dshm": "lib/bin.js"
  },
  "files": [
    "lib",
    "registry",
    "web"
  ],
  "repository": {
